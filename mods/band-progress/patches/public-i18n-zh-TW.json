{
  "file": "public/i18n/zh-TW.json",
  "patches": [
    {
      "id": "i18n-band-progress-zh-TW",
      "op": "json-merge",
      "merge": {
        "{when}已购 {x} 名 · 本回合 +{x} 已到账": "{when}已購 {x} 名 · 本回合 +{x} 已入帳",
        "已售 {sold}/{goal}": "已售 {sold}/{goal}",
        "已完成": "已完成",
        "本回合 +{x} 已到账": "本回合 +{x} 已入帳",
        "本回合已得 {got}/{max}": "本回合已得 {got}/{max}",
        "本回合已购 {x} 名 · 下回合 +{x}": "本回合已購 {x} 名 · 下回合 +{x}",
        "本回合已购 {x}/{max}": "本回合已購 {x}/{max}",
        "第 {st} 回合": "第 {st} 回合",
        "累计花费 {shown}/{goal}": "累計花費 {shown}/{goal}",
        "累计花费 {shown}/{goal} · 已完成": "累計花費 {shown}/{goal} · 已完成",
        "该道具已累计的出售数（每卖满一次后清零重新累计）": "該道具已累計的出售數（每賣滿一次後清零重新累計）",
        "距下次 {acc}/{goal}": "距下次 {acc}/{goal}",
        "距下次 {toNext}/{every} · 本回合已得 {got}/{max}": "距下次 {toNext}/{every} · 本回合已得 {got}/{max}",
        "距下次 {toNext}/{every}(累计刷新 {total})": "距下次 {toNext}/{every}(累計刷新 {total})"
      }
    }
  ]
}
