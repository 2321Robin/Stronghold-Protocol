{
  "file": "public/i18n/ko.json",
  "patches": [
    {
      "id": "i18n-band-progress-ko",
      "op": "json-merge",
      "merge": {
        "{when}已购 {x} 名 · 本回合 +{x} 已到账": "{when} 구매 {x}명 · 이번 라운드 +{x} 지급",
        "本回合 +{x} 已到账": "이번 라운드 +{x} 지급",
        "本回合已得 {got}/{max}": "이번 라운드 획득 {got}/{max}",
        "本回合已购 {x} 名 · 下回合 +{x}": "이번 라운드 구매 {x}명 · 다음 라운드 +{x}",
        "本回合已购 {x}/{max}": "이번 라운드 구매 {x}/{max}",
        "第 {st} 回合": "{st}번째 라운드",
        "该道具已累计的出售数（每卖满一次后清零重新累计）": "해당 아이템의 누적 판매 수(한 번 다 팔면 초기화 후 다시 집계)",
        "距下次 {acc}/{goal}": "다음까지 {acc}/{goal}",
        "距下次 {toNext}/{every} · 本回合已得 {got}/{max}": "다음까지 {toNext}/{every} · 이번 라운드 획득 {got}/{max}",
        "距下次 {toNext}/{every}(累计刷新 {total})": "다음까지 {toNext}/{every}(누적 갱신 {total})",
        "累计花费 {shown}/{goal}": "누적 소모 {shown}/{goal}",
        "累计花费 {shown}/{goal} · 已完成": "누적 소모 {shown}/{goal} · 완료",
        "上回合": "이전 라운드",
        "已售 {sold}/{goal}": "판매 {sold}/{goal}",
        "已完成": "완료"
      }
    }
  ]
}
