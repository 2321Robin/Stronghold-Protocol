{
  "file": "public/i18n/en.json",
  "patches": [
    {
      "id": "i18n-band-progress",
      "op": "json-merge",
      "merge": {
        "累计花费 {shown}/{goal} · 已完成": "Cumulative spend {shown}/{goal} · complete",
        "累计花费 {shown}/{goal}": "Cumulative spend {shown}/{goal}",
        "已完成": "complete",
        "距下次 {acc}/{goal}": "{acc}/{goal} to the next",
        "距下次 {toNext}/{every}(累计刷新 {total})": "{toNext}/{every} to the next (refreshed {total} overall)",
        "本回合已得 {got}/{max}": "granted {got}/{max} this round",
        "距下次 {toNext}/{every} · 本回合已得 {got}/{max}": "{toNext}/{every} to the next · granted {got}/{max} this round",
        "上回合": "Last round",
        "第 {st} 回合": "Round {st}",
        "{when}已购 {x} 名 · 本回合 +{x} 已到账": "{when}: bought {x} · +{x} arrived this round",
        "本回合 +{x} 已到账": "+{x} arrived this round",
        "本回合已购 {x} 名 · 下回合 +{x}": "Bought {x} this round · next round +{x}",
        "本回合已购 {x}/{max}": "Bought {x}/{max} this round",
        "已售 {sold}/{goal}": "Sold {sold}/{goal}",
        "该道具已累计的出售数（每卖满一次后清零重新累计）": "Operators sold toward this item's grant (the count resets after each grant)"
      }
    }
  ]
}
