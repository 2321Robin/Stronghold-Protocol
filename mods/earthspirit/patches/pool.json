      "anchor": "const banned = [];",
      "op": "replace",
      "old": [
        "const banned = [];",
        "for (const id of gd.visibleChess) {"
      ],
      "new": [
        "const banned = [];",
        "for (const id of [...gd.visibleChess, ...extraChess]) {"
