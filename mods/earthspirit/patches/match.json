{
  "file": "server/match/Match.js",
  "patches": [
    {
      "id": "import-extraChessOf",
      "anchor": "import { PHASE, modeIdFor } from '../../shared/constants.js';",
      "op": "insert-before",
      "new": ["import { extraChessOf } from '../../shared/protocol.js';"]
    },
    {
      "id": "match-extras-field",
      "anchor": "this.data = opts.data && typeof opts.data === 'object' ? opts.data : {};",
      "op": "insert-after",
      "new": [
        "// per-match opt-in extras (local mod, room.setExtras): extras.earthspirit adds hidden chess_char_1_11_a to the pool",
        "this.extras = { earthspirit: !!(opts.extras && opts.extras.earthspirit) };",
        "this.extraChess = extraChessOf(this.extras);"
      ]
    },
    {
      "id": "pass-extra-to-bans",
      "anchor": "const bans = drawDisabledBonds(this.gd, this.rngSetup);",
      "op": "replace",
      "old": ["const bans = drawDisabledBonds(this.gd, this.rngSetup);"],
      "new": ["const bans = drawDisabledBonds(this.gd, this.rngSetup, this.extraChess);"]
    },
    {
      "id": "pass-extra-to-pool",
      "anchor": "this.pool = new SharedPool(this.gd, { banned: bans.banned });",
      "op": "replace",
      "old": ["this.pool = new SharedPool(this.gd, { banned: bans.banned });"],
      "new": ["this.pool = new SharedPool(this.gd, { banned: bans.banned, extraChess: this.extraChess });"]
    }
  ]
}
